{
  "ci": {
    "collect": {
      "staticDistDir": "./.lighthouse-root",
      "url": [
        "http://localhost/LexMX/",
        "http://localhost/LexMX/chat/",
        "http://localhost/LexMX/wiki/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new --disable-gpu --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:best-practices": [
              "warn",
              {
                "minScore": 0.9
              }
            ],
            "categories:performance": [
              "warn",
              {
                "minScore": 0.8
              }
            ],
            "color-contrast": "error",
            "heading-order": "error",
            "label-content-name-mismatch": "error",
            "resource-summary:stylesheet:size": [
              "error",
              {
                "maxNumericValue": 61440
              }
            ],
            "resource-summary:document:size": [
              "error",
              {
                "maxNumericValue": 40960
              }
            ],
            "resource-summary:third-party:count": [
              "error",
              {
                "maxNumericValue": 2
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*/LexMX/(wiki/)?$",
          "assertions": {
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 204800
              }
            ],
            "resource-summary:total:size": [
              "error",
              {
                "maxNumericValue": 614400
              }
            ],
            "resource-summary:script:count": [
              "error",
              {
                "maxNumericValue": 30
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*/chat/$",
          "assertions": {
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 491520
              }
            ],
            "resource-summary:total:size": [
              "error",
              {
                "maxNumericValue": 819200
              }
            ],
            "resource-summary:script:count": [
              "error",
              {
                "maxNumericValue": 50
              }
            ],
            "resource-summary:third-party:count": [
              "error",
              {
                "maxNumericValue": 6
              }
            ],
            "categories:performance": [
              "warn",
              {
                "minScore": 0.6
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  },
  "_comment": "Budgets: /* script \u2264 200 KB, /chat script \u2264 480 KB (React, react-markdown, RAG client; transformers.js and web-llm load lazily). Third-party on /chat is the Google Fonts stylesheet plus the multilingual-e5-small tokenizer/config fetched at engine init; the model weights themselves stream later. Accessibility \u2265 0.9 is an error; color-contrast, heading-order and label-content-name-mismatch must pass."
}
