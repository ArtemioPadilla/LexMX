{
  "ci": {
    "collect": {
      "staticDistDir": "./.lighthouse-root",
      "url": [
        "http://localhost/LexMX/",
        "http://localhost/LexMX/chat/",
        "http://localhost/LexMX/wiki/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new --disable-gpu --disable-dev-shm-usage"
      }
    },
    "assert": {
      "budgetsFile": "./lighthouse-budgets.json",
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
