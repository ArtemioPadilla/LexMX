---
/** Proceso legislativo federal (artículos 71 y 72 constitucionales), estático. */
interface Step { id: string; title: string; description: string; details: string[]; duration: string; actors: string[]; requirements: string[] }
const steps: Step[] = [
  { id: 'iniciativa', title: 'Iniciativa', description: 'Presentación del proyecto de ley por los sujetos facultados (artículo 71)', duration: '1-7 días',
    details: ['El proyecto se presenta por escrito ante alguna de las cámaras', 'Debe incluir exposición de motivos y articulado', 'Se turna a comisiones para su análisis', 'Se publica en la Gaceta Parlamentaria'],
    actors: ['Presidencia de la República', 'Diputados y senadores', 'Legislaturas de los estados y de la Ciudad de México', 'Ciudadanos (iniciativa ciudadana, 0.13 % de la lista nominal)'],
    requirements: ['Exposición de motivos', 'Articulado propuesto', 'Régimen transitorio (si aplica)'] },
  { id: 'dictamen', title: 'Dictamen', description: 'Análisis y modificación del proyecto por las comisiones', duration: '30-90 días',
    details: ['Las comisiones estudian la iniciativa', 'Se realizan audiencias públicas si es necesario', 'Se elabora dictamen con modificaciones', 'Puede aprobarse, modificarse o desecharse'],
    actors: ['Comisiones dictaminadoras', 'Especialistas', 'Organizaciones civiles', 'Ciudadanía interesada'],
    requirements: ['Análisis jurídico', 'Impacto presupuestal', 'Consulta a especialistas'] },
  { id: 'camara-origen', title: 'Discusión en Cámara de Origen', description: 'Debate y votación en la cámara donde se presentó la iniciativa', duration: '1-15 días',
    details: ['Lectura del dictamen en el pleno', 'Debate en lo general y en lo particular', 'Presentación y votación de reservas', 'Votación final del proyecto'],
    actors: ['Diputados o senadores', 'Mesa Directiva', 'Grupos parlamentarios'],
    requirements: ['Quórum legal', 'Mayoría simple o calificada según el caso', 'Registro de votación'] },
  { id: 'camara-revisora', title: 'Cámara Revisora', description: 'Revisión y votación en la segunda cámara', duration: '30-60 días',
    details: ['Se envía el proyecto aprobado (minuta)', 'Nueva revisión por comisiones', 'Debate en el pleno de la cámara revisora', 'Votación final; si hay modificaciones regresa a la cámara de origen'],
    actors: ['Segunda cámara (Diputados o Senadores)', 'Comisiones de la cámara revisora'],
    requirements: ['Mismo procedimiento que la cámara de origen', 'Si hay modificaciones, regresa a origen (artículo 72, inciso E)'] },
  { id: 'ejecutivo', title: 'Ejecutivo Federal', description: 'Promulgación o veto del proyecto (artículo 72, incisos A a C)', duration: 'Hasta 30 días naturales',
    details: ['El Ejecutivo tiene 30 días naturales para hacer observaciones', 'Puede promulgar la ley', 'Puede devolverla con observaciones (veto), que el Congreso supera con dos tercios', 'Si no hace observaciones, se considera aprobada y debe promulgarse'],
    actors: ['Presidencia de la República', 'Secretarías de Estado', 'Consejería Jurídica'],
    requirements: ['Revisión de constitucionalidad', 'Análisis de viabilidad'] },
  { id: 'publicacion', title: 'Publicación', description: 'Publicación en el Diario Oficial de la Federación', duration: '1-30 días',
    details: ['La ley se publica en el DOF', 'Entra en vigor según sus artículos transitorios', 'Se notifica a las autoridades competentes', 'Inicia la reglamentación si es necesaria'],
    actors: ['Secretaría de Gobernación', 'Diario Oficial de la Federación'],
    requirements: ['Firma de la Presidencia', 'Refrendo de la Secretaría correspondiente'] },
];
---

<ol class="relative space-y-3 border-l border-gray-200 pl-6 dark:border-gray-700">
  {steps.map((step, i) => (
    <li class="relative">
      <span aria-hidden="true" class="absolute -left-[1.85rem] top-2 grid h-6 w-6 place-items-center rounded-full bg-legal-600 text-xs font-semibold text-white">{i + 1}</span>
      <details class="group rounded-lg border border-gray-200 dark:border-gray-700" open={i === 0}>
        <summary class="flex cursor-pointer list-none flex-wrap items-center justify-between gap-2 px-4 py-3 [&::-webkit-details-marker]:hidden">
          <span>
            <span class="font-semibold text-gray-900 dark:text-white">{step.title}</span>
            <span class="block text-sm text-gray-600 dark:text-gray-300">{step.description}</span>
          </span>
          <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-700 dark:bg-gray-700 dark:text-gray-200">⏱ {step.duration}</span>
        </summary>
        <div class="grid gap-4 border-t border-gray-200 p-4 text-sm dark:border-gray-700 md:grid-cols-3">
          <div>
            <h4 class="mb-1 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Qué ocurre</h4>
            <ul class="list-inside list-disc text-gray-700 dark:text-gray-300">{step.details.map((d) => <li>{d}</li>)}</ul>
          </div>
          <div>
            <h4 class="mb-1 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Quién participa</h4>
            <ul class="list-inside list-disc text-gray-700 dark:text-gray-300">{step.actors.map((d) => <li>{d}</li>)}</ul>
          </div>
          <div>
            <h4 class="mb-1 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Requisitos</h4>
            <ul class="list-inside list-disc text-gray-700 dark:text-gray-300">{step.requirements.map((d) => <li>{d}</li>)}</ul>
          </div>
        </div>
      </details>
    </li>
  ))}
</ol>
