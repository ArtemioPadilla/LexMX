---
import BaseLayout from '../components/layout/BaseLayout.astro';
import TemplatesIsland from '../islands/TemplatesIsland.tsx';
import { getTranslation } from '../i18n/utils';
const t = getTranslation(Astro.url);
---

<BaseLayout title={`${t('templates.title')} - LexMX`} description={t('templates.subtitle')}>
  <div class="min-h-screen bg-white dark:bg-gray-900">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white print:hidden" data-i18n="templates.title">{t('templates.title')}</h1>
      <p class="mt-2 mb-8 text-gray-600 dark:text-gray-300 print:hidden" data-i18n="templates.subtitle">{t('templates.subtitle')}</p>
      <TemplatesIsland client:only="react" />
    </div>
  </div>
</BaseLayout>

<style>
  @media print {
    :global(header), :global(footer), :global(form), :global(ul), :global(nav), :global(button) { display: none !important; }
  }
</style>
