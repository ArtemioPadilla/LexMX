---
import BaseLayout from '../components/layout/BaseLayout.astro';
import TablesIsland from '../islands/TablesIsland.tsx';
import { getTranslation } from '../i18n/utils';
const t = getTranslation(Astro.url);
---

<BaseLayout title={`${t('tables.title')} - LexMX`} description={t('tables.subtitle')}>
  <div class="min-h-screen bg-white dark:bg-gray-900">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white" data-i18n="tables.title">{t('tables.title')}</h1>
      <p class="mt-2 mb-8 text-gray-600 dark:text-gray-300" data-i18n="tables.subtitle">{t('tables.subtitle')}</p>
      <TablesIsland client:only="react" />
    </div>
  </div>
</BaseLayout>
