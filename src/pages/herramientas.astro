---
import BaseLayout from '../components/layout/BaseLayout.astro';
import CalculatorsIsland from '../islands/CalculatorsIsland.tsx';
import OcrIsland from '../islands/OcrIsland.tsx';
import TranscribeIsland from '../islands/TranscribeIsland.tsx';
import { getTranslation } from '../i18n/utils';
const t = getTranslation(Astro.url);
---

<BaseLayout title={`${t('tools.title')} - LexMX`} description={t('tools.subtitle')}>
  <div class="min-h-screen bg-white dark:bg-gray-900">
    <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white" data-i18n="tools.title">{t('tools.title')}</h1>
      <p class="mt-2 mb-8 text-gray-600 dark:text-gray-300" data-i18n="tools.subtitle">{t('tools.subtitle')}</p>
      <CalculatorsIsland client:only="react" />
      <hr class="my-12 border-gray-200 dark:border-gray-700" />
      <OcrIsland client:only="react" />
      <hr class="my-12 border-gray-200 dark:border-gray-700" />
      <TranscribeIsland client:only="react" />
    </div>
  </div>
</BaseLayout>
