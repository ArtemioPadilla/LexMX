---
/**
 * /document/<id>: one page per document in the published corpus. Ids come
 * from public/legal-corpus/metadata.json at build time (the Pages deploy
 * downloads the corpus-latest release before building) plus a fallback list,
 * so every law in the corpus gets a static page. Unknown ids are handled by
 * 404.astro, which loads the viewer client-side. `getStaticPaths` runs in an
 * isolated scope, so everything it needs is imported.
 */
import BaseLayout from '../../components/layout/BaseLayout.astro';
import HydrationWrapper from '../../components/HydrationWrapper.astro';
import DocumentViewerWrapper from '../../islands/DocumentViewerWrapper.tsx';
import { documentPages } from '../../lib/corpus/build-manifest';

export function getStaticPaths() {
  return documentPages().map((doc) => ({ params: { id: doc.id }, props: { title: doc.title, primaryArea: doc.primaryArea } }));
}

const { id } = Astro.params;
const { title, primaryArea } = Astro.props as { title: string; primaryArea?: string };
---

<BaseLayout title={`${title} - LexMX`} description={`${title}: texto vigente, artículos y búsqueda${primaryArea ? ` · ${primaryArea}` : ''}. Fuente oficial enlazada.`}>
  <div class="min-h-screen bg-white dark:bg-gray-900">
    <HydrationWrapper name="document-viewer">
      <DocumentViewerWrapper documentId={id} documentTitle={title} client:load />
    </HydrationWrapper>
  </div>
</BaseLayout>
