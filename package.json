{
  "name": "lexmx",
  "type": "module",
  "version": "1.0.0",
  "description": "Mexican Legal AI Assistant with RAG technology",
  "scripts": {
    "dev": "astro dev",
    "dev:proxy": "node scripts/dev-proxy.js",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "type-check": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --config=playwright.e2e.config.ts",
    "test:integration": "playwright test --config=playwright.config.ts",
    "test:dev": "node scripts/test-local-dev.js",
    "test:all": "npm run test:unit && npm run test:e2e",
    "build:corpus": "npm run corpus:import",
    "build:embeddings": "npm run corpus:embeddings",
    "validate:all": "npm run lint && npm run type-check",
    "check:astro": "astro check",
    "check:pragmas": "node scripts/check-ts-pragmas.mjs",
    "ratchet": "node scripts/ratchet.mjs",
    "ratchet:update": "node scripts/ratchet.mjs --update",
    "type-check:strict": "tsc --noEmit -p tsconfig.strict.json",
    "check": "npm-run-all --parallel ratchet type-check:strict test lint check:pragmas --serial build",
    "doctor": "bash scripts/doctor.sh",
    "ship": "bash scripts/ship.sh",
    "monday": "bash scripts/monday.sh",
    "new-issue": "bash scripts/new-issue.sh",
    "hooks:install": "git config core.hooksPath scripts/hooks && echo 'Pre-commit hooks installed.'",
    "corpus:import": "node --experimental-strip-types scripts/corpus/import-legalia.ts",
    "corpus:embeddings": "node --experimental-strip-types scripts/corpus/build-embeddings.ts"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@mlc-ai/web-llm": "^0.2.79",
    "@nanostores/persistent": "^1.1.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@xenova/transformers": "^2.17.2",
    "astro": "^5.18.2",
    "events": "^3.3.0",
    "mammoth": "^1.8.0",
    "nanostores": "^1.0.1",
    "pdfjs-dist": "^4.4.168",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.6.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.47.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.5.5",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "astro-compress": "^2.4.0",
    "astro-eslint-parser": "^1.0.0",
    "axe-playwright": "^2.0.1",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.36.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "glob": "^11.0.3",
    "jsdom": "^26.1.0",
    "node-fetch": "^3.3.2",
    "npm-run-all": "^4.1.5",
    "sharp": "^0.34.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "onnxruntime-web": "^1.27.0"
  }
}
